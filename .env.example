# Azure OpenAI resource endpoint, for example:
# https://your-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT=

# Deployment name in Azure AI Foundry / Azure OpenAI (not necessarily the base model name)
AZURE_OPENAI_CHAT_MODEL=

# Optional. Set a version supported by the Azure OpenAI Responses API on your resource.
AZURE_OPENAI_API_VERSION=
